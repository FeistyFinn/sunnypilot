<?xml version='1.0' encoding='UTF-8'?>
<root>
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab tab_name="VTB Coop Steering" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="0.25;0.25;0.25;0.25" count="4">
     <DockArea name="Driver torque vs commanded vs measured angle">
      <plot flip_y="false" flip_x="false" mode="TimeSeries" style="Lines">
       <range right="100.000000" top="20.000000" left="0.000000" bottom="-20.000000"/>
       <limitY/>
       <curve name="/carState/steeringTorque" color="#1f77b4"/>
       <curve name="/carControl/actuators/steeringAngleDeg" color="#ff7f0e"/>
       <curve name="/carOutput/actuatorsOutput/steeringAngleDeg" color="#d62728"/>
       <curve name="/carState/steeringAngleDeg" color="#1ac938"/>
      </plot>
     </DockArea>
     <DockArea name="Speed">
      <plot flip_y="false" flip_x="false" mode="TimeSeries" style="Lines">
       <range right="100.000000" top="40.000000" left="0.000000" bottom="-1.000000"/>
       <limitY/>
       <curve name="/carState/vEgo" color="#9467bd"/>
      </plot>
     </DockArea>
     <DockArea name="COOP_STEERING flag + enabled / lat active">
      <plot flip_y="false" flip_x="false" mode="TimeSeries" style="Lines">
       <range right="100.000000" top="1.050000" left="0.000000" bottom="-0.050000"/>
       <limitY/>
       <curve name="COOP_STEERING flag (CP_SP.flags &amp; 2)" color="#e377c2"/>
       <curve name="/selfdriveState/enabled" color="#1f77b4"/>
       <curve name="/carControl/latActive" color="#ff7f0e"/>
      </plot>
     </DockArea>
     <DockArea name="Panda controlsAllowed / safetyModel">
      <plot flip_y="false" flip_x="false" mode="TimeSeries" style="Lines">
       <range right="100.000000" top="30.000000" left="0.000000" bottom="-1.000000"/>
       <limitY/>
       <curve name="/pandaStates/0/controlsAllowed" color="#1ac938"/>
       <curve name="/pandaStates/0/controlsAllowedLateral" color="#17becf"/>
       <curve name="/pandaStates/0/safetyModel" color="#d62728"/>
       <curve name="/pandaStates/0/safetyParam" color="#8c564b"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <!-- - - - - - - - - - - - - - - -->
 <!-- - - - - - - - - - - - - - - -->
 <Plugins>
  <plugin ID="DataLoad Rlog"/>
  <plugin ID="Cereal Subscriber"/>
 </Plugins>
 <!-- - - - - - - - - - - - - - - -->
 <!-- - - - - - - - - - - - - - - -->
 <customMathEquations>
  <snippet name="COOP_STEERING flag (CP_SP.flags &amp; 2)">
   <global></global>
   <function>-- TeslaFlagsSP.COOP_STEERING = 2 (bit 1) in carParamsSP.flags
-- bit 0 (value 1) is HAS_VEHICLE_BUS; mask with 2 to isolate coop steering
if (math.floor(value / 2) % 2) == 1 then
  return 1
end
return 0</function>
   <linked_source>/carParamsSP/flags</linked_source>
  </snippet>
 </customMathEquations>
 <snippets/>
 <!-- - - - - - - - - - - - - - - -->
</root>