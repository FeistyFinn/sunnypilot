{
  // ---- Editor basics ----
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.renderWhitespace": "trailing",
  "files.trimTrailingWhitespace": true,

  // ---- Python: interpreter + openpilot.* import resolution ----
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  // "off" still flags unresolved imports / undefined names / syntax, but skips the type-error
  // noise from this repo's dynamic capnp/attribute patterns (which the project already ignores in [tool.ty]).
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.exclude": [
    "**/.git",
    "**/.venv",
    "**/__pycache__",
  ],

  // ---- Ruff as Python linter + formatter (rules live in pyproject.toml, auto-picked per folder) ----
  "ruff.importStrategy": "fromEnvironment",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },

  // ---- pytest (addopts already run -n auto; use -p no:xdist when debugging one test) ----
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,

  // ---- C/C++: clangd owns IntelliSense; cpptools kept only for the cppdbg debugger ----
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": ["--background-index", "--header-insertion=never"],

  // ---- File-type associations ----
  "files.associations": {
    "*.capnp": "capnp",
    "*.dbc": "dbc"
  },

  // ---- Search: keep opendbc_repo + panda searchable (VTB code); hide big/irrelevant trees ----
  "search.followSymlinks": false,
  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/tinygrad_repo": true,
    "**/msgq_repo": true,
    "**/rednose_repo": true,
    "**/teleoprtc_repo": true,
    "**/neural_network_data": true,
    "**/generated": true,
    "**/*.onnx": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/tinygrad_repo/**": true,
    "**/msgq_repo/**": true,
    "**/rednose_repo/**": true,
    "**/teleoprtc_repo/**": true,
    "**/neural_network_data/**": true,
    "**/compile_commands.json": true
  }
}
