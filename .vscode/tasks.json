{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "op: build",
      "type": "shell",
      "command": "./tools/op.sh build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "scons build; also (re)generates compile_commands.json for clangd"
    },
    {
      "label": "op: lint",
      "type": "shell",
      "command": "./tools/op.sh lint",
      "problemMatcher": [],
      "detail": "ruff + codespell"
    },
    {
      "label": "op: test",
      "type": "shell",
      "command": "./tools/op.sh test",
      "group": "test",
      "problemMatcher": [],
      "detail": "full pytest suite (add -m 'not slow' interactively to skip slow)"
    },
    {
      "label": "opendbc: Tesla safety (VTB gate)",
      "type": "shell",
      "command": "PYTHONPATH=\"$PWD\" .venv/bin/python -m pytest opendbc/safety/tests/test_tesla.py -c /dev/null --noconftest -q",
      "options": { "cwd": "${workspaceFolder}/opendbc_repo" },
      "group": "test",
      "problemMatcher": [],
      "detail": "The safety gate for any steering / long-on-gas change — must stay green"
    }
  ]
}
